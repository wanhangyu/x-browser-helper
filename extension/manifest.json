{
  "manifest_version": 3,
  "name": "X 浏览助手",
  "version": "1.9.2",
  "description": "X 帖子平均热度、热点榜、粉丝与书签数、图片缩放与长图阅读、内容过滤、Markdown 复制与固定搜索。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X 浏览助手"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://pro.x.com/*"
      ],
      "js": [
        "core.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://pro.x.com/*"
      ],
      "js": [
        "post-dom.js",
        "extras-core.js",
        "filter-rules.js",
        "extras.js",
        "long-image-viewer.js",
        "image-viewer.js",
        "content.bundle.js",
        "translation.js",
        "follow.js",
        "reading.js"
      ],
      "run_at": "document_start",
      "css": [
        "extras.css",
        "media.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "translation-options.html",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
