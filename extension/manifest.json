{
  "manifest_version": 3,
  "name": "X 浏览助手",
  "version": "1.8.5",
  "description": "X 帖子平均热度、本页热点榜、账号粉丝与简介翻译、固定搜索、沉浸阅读，帮助你发现和筛选有价值的内容。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X 浏览助手"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://pro.x.com/*"
      ],
      "js": [
        "core.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://pro.x.com/*"
      ],
      "js": [
        "post-dom.js",
        "content.bundle.js",
        "translation.js",
        "follow.js",
        "reading.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "translation-background.js"
  },
  "options_page": "translation-options.html",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
